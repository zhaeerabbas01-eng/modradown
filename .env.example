# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# Local Server Setup (Not used in Netlify Serverless)
PORT=3000
FRONTEND_URL=*

# Leave this empty on Netlify to use relative pathing for the API
VITE_API_BASE_URL=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# INSTAGRAM_COOKIE: Add your Instagram Cookie here (e.g. sessionid=...) to bypass rate limits
INSTAGRAM_COOKIE=